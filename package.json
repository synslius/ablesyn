{
  "name": "ablesyn",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "A small evidence contract language for agent capability, belief, limits, probes, and verdicts.",
  "author": "Hengyuan Zhu",
  "repository": {
    "type": "git",
    "url": "https://github.com/synslius/ablesyn.git"
  },
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ablesyn": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples"
  ],
  "scripts": {
    "ablesyn": "bun run src/cli.ts",
    "parse": "bun run src/cli.ts parse",
    "check": "bun run src/cli.ts check examples/hello.able examples/capability-claim.able examples/self-verification.able",
    "verify": "node scripts/verify.mjs",
    "test": "bun test",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0"
  }
}
